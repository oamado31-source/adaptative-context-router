{
  "name": "@acr/adaptative-context-router",
  "version": "0.1.0",
  "private": true,
  "description": "Adaptive context-engineering orchestrator for Claude Code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oamado31-source/adaptative-context-router.git"
  },
  "homepage": "https://github.com/oamado31-source/adaptative-context-router",
  "keywords": [
    "claude-code",
    "context-engineering",
    "token-optimization",
    "routing",
    "telemetry",
    "benchmarking"
  ],
  "type": "module",
  "bin": {
    "acr": "dist/cli/router.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:check": "npm run typecheck && npm run lint && npm test && npm run build && node dist/cli/router.js version && node dist/cli/router.js status --json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
